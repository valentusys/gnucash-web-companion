# gnucash-web-companion — write-alpha operator reference
#
# DANGER: this file is NOT a safe default .env template.
# Do not copy it blindly to .env.
# It is a reference for explicit local write-alpha testing only.
#
# Never use this with a real/private book, an original book, or the only copy of any book.
# Use only synthetic, disposable, or copied-test books that can be deleted and restored.
# Keep the service local-only; do not expose write-alpha testing to the public internet or an
# untrusted LAN/VPN.

# Write-alpha is intentionally blocked unless BOTH of these are set explicitly.
# The normal .env.example and docker-compose defaults keep writes disabled.
APP_ENV=test
GNUCASH_WRITES_ENABLED=true

# Point only at a synthetic/disposable/copied-test book inside the container runtime.
# The original book must never be mounted or referenced for write-alpha testing.
GNUCASH_DEFAULT_BOOK_PATH=/data/books/write-alpha-disposable-copy.gnucash.sqlite

# Backups must be enabled and reviewed before any mutation attempt.
GNUCASH_BACKUP_DIR=/data/backups

# Use fresh local-only dummy secrets for disposable test runs.
# Do not reuse production/LAN/VPN credentials in write-alpha tests.
JWT_SECRET=replace-with-fresh-local-test-secret
JWT_TOKEN_EXPIRE_MINUTES=30
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-local-test-password
APP_ADMIN_PASSWORD_HASH=

# Keep origins narrow and local for write-alpha testing.
ORIGIN=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080"]
PUBLIC_APP_NAME=GnuCash Web Companion
API_INTERNAL_URL=http://api:8000
APP_DATABASE_URL=sqlite:////data/app/app.db
