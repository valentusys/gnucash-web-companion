{
	"name": "gnucash-web-companion-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:auth-routes": "node scripts/test-auth-routes.mjs",
		"test:transaction-entry-preview": "node scripts/test-transaction-entry-preview.mjs",
		"test:transaction-entry-preview-browser": "npm run build && node scripts/test-transaction-entry-preview-browser.mjs",
		"test:transaction-entry-create-disposable-browser": "npm run build && node scripts/test-transaction-entry-preview-browser.mjs",
		"test:reports": "node scripts/test-reports-static.mjs",
		"test:reports-browser": "npm run build && node scripts/test-reports-browser.mjs",
		"test:money-strings": "node scripts/test-money-strings.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"prettier": "^3.2.0",
		"prettier-plugin-svelte": "^3.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.3.0",
		"vite": "^6.0.0"
	}
}
