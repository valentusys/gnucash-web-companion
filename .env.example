# gnucash-web-companion — Environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# GnuCash book
# ---------------------------------------------------------------------------
# Path to the GnuCash book file (SQLite) or a piecash-compatible connection
# string. For SQLite, this should be an absolute path or a path relative to
# the data/ directory.
#
# Examples:
#   GNUCASH_BOOK_PATH=/data/my-book.gnucash
#   GNUCASH_BOOK_PATH=data/my-book.gnucash
GNUCASH_BOOK_PATH=data/my-book.gnucash

# ---------------------------------------------------------------------------
# App metadata database
# ---------------------------------------------------------------------------
# Path to the SQLite database used for app metadata (user preferences, saved
# filters, cache/index state). This must NOT be the same file as the GnuCash
# book.
APP_DB_PATH=data/app-metadata.db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Host and port for the FastAPI backend.
API_HOST=0.0.0.0
API_PORT=8000

# Host and port for the SvelteKit frontend (development server).
WEB_HOST=0.0.0.0
WEB_PORT=5173

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret key for session signing and other cryptographic operations.
# Generate a strong random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-secret

# Set to "true" to enable a simple app-level login (not yet implemented).
# In early versions, authentication is expected to be handled by a reverse
# proxy (e.g., Authelia, Authentik, basic auth behind nginx).
APP_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to "true" to enable privacy mode by default (blurs sensitive numbers).
PRIVACY_MODE_DEFAULT=false
