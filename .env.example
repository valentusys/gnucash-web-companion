# gnucash-web-companion — Environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Use a test copy of your GnuCash book for pre-alpha builds.

APP_ENV=development

# Separate app metadata database. Do not point this at a GnuCash book.
APP_DATABASE_URL=sqlite:////data/app/app.db

# Path or URI to the default GnuCash SQL book.
# Prefer a disposable/test copy while the project is pre-alpha.
GNUCASH_DEFAULT_BOOK_PATH=/data/books/main.gnucash.sqlite

# REQUIRED: replace this placeholder with a fresh long random value before login will work.
# Example: openssl rand -hex 32
# Rotate after any .env exposure or before moving shared LAN/VPN testing to a new trusted group.
JWT_SECRET=change-me-use-a-long-random-secret
JWT_TOKEN_EXPIRE_MINUTES=30

# Bootstrap admin account. Prefer APP_ADMIN_PASSWORD_HASH for non-local use.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_PASSWORD_HASH=

# MVP v0.1 is read-only. Keep writes disabled unless explicitly testing post-MVP write flows.
GNUCASH_WRITES_ENABLED=false

PUBLIC_APP_NAME=GnuCash Web Companion
API_INTERNAL_URL=http://api:8000
# Public origin used by SvelteKit behind the Caddy reverse proxy.
ORIGIN=http://localhost:8080
# Development default. For LAN/VPN shared testing, narrow this to exact browser origins.
# Recommended examples by mode:
# - localhost: CORS_ORIGINS=["http://localhost:8080"]
# - trusted LAN: CORS_ORIGINS=["http://gnucash.lan:8080","http://192.168.1.50:8080"]
# - VPN/private HTTPS: CORS_ORIGINS=["https://gnucash.vpn.example"]
# Avoid the wildcard outside single-machine development.
CORS_ORIGINS=["*"]
